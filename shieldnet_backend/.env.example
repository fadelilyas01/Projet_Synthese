# =====================================================================
# ShieldNet Backend — Modèle de configuration d'environnement (.env.example)
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement
# IMPORTANT : Ne jamais commiter de fichier .env contenant de vraies clés.
# =====================================================================

# Clé secrète Django (Générez une clé cryptographique en production via secrets.token_urlsafe(50))
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production-min32chars

# Mode débogage (True en développement local, False en production)
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules si plusieurs)
ALLOWED_HOSTS=*

# Clé API partagée avec l'application mobile ShieldNet
API_KEY=change-me-to-a-secure-random-api-key-token

# Sel cryptographique pour le hachage HMAC-SHA256 (doit correspondre au mobile)
HASH_SALT=change-me-to-a-secure-random-crypto-salt-token

# Configuration Base de données (Laisser commenté pour SQLite local par défaut)
# POSTGRES_DB=shieldnet_db
# POSTGRES_USER=shieldnet_user
# POSTGRES_PASSWORD=votre_mot_de_passe_db_robuste
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Compte Administrateur Initial (Accès Web / Mobile)
ADMIN_EMAIL=admin@shieldnet.app
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# =====================================================================
# Configuration SMTP (Expédition des courriels OTP & réinitialisation)
# =====================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_adresse@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_d_application_16_lettres
DEFAULT_FROM_EMAIL=no-reply@shieldnet.app
