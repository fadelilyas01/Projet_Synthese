# =====================================================================
# ShieldNet Backend — Configuration d'Environnement (.env.example)
# Développé pour la séparation stricte : Développement vs Production
# IMPORTANT : Ne jamais commiter de fichier .env contenant de vraies clés.
# =====================================================================

# ---------------------------------------------------------------------
# 1. ENVIRONNEMENT & DÉBOGAGE
# ---------------------------------------------------------------------
# Valeurs acceptées : development | staging | production
DJANGO_ENV=development

# Mode débogage (True en développement local, STRICTEMENT False en production)
DJANGO_DEBUG=True

# ---------------------------------------------------------------------
# 2. SECRETS CRYPTOGRAPHIQUES (Obligatoires et durcis en production)
# En production, générez les clés avec :
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------
SECRET_KEY=dev-ephemeral-local-development-secret-key-min32chars
API_KEY=dev-local-api-key-test-do-not-use-in-prod
HASH_SALT=dev-local-hash-salt-test-do-not-use-in-prod

# ---------------------------------------------------------------------
# 3. CONTRÔLE D'ACCÈS HTTP, CORS & CSRF
# ---------------------------------------------------------------------
# Hôtes autorisés (séparés par des virgules) - Interdiction absolue de '*' en production
ALLOWED_HOSTS=*

# Origines autorisées pour les requêtes multi-origines (CORS)
# En production : https://admin.shieldnet.app,https://shieldnet.app
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Origines de confiance pour la protection CSRF (Django 4+ sous HTTPS)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------
# 4. SÉCURITÉ TLS / SSL (Actif quand DJANGO_DEBUG=False)
# ---------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------
# 5. BASE DE DONNÉES (PostgreSQL en Production, SQLite en Développement)
# ---------------------------------------------------------------------
# Décommentez pour utiliser PostgreSQL :
# POSTGRES_DB=shieldnet_db
# POSTGRES_USER=shieldnet_user
# POSTGRES_PASSWORD=votre_mot_de_passe_db_robuste
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# 6. CACHE DISTRIBUÉ & REDIS (Optionnel en dev, recommandé en prod)
# ---------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------------
# 7. COMPTE ADMINISTRATEUR SOC INITIAL (Provisionné par ensure_admin)
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@shieldnet.app
ADMIN_PASSWORD=AdminSecurePassword123!

# ---------------------------------------------------------------------
# 8. EXPÉDITION DES COURRIELS (SMTP / OTP)
# ---------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ShieldNet <no-reply@shieldnet.app>
