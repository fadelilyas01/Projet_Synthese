# =====================================================================
# ShieldNet Backend — Modèle d'Environnement de PRODUCTION (.env.production.example)
# Copiez ce fichier sous le nom .env.production sur votre serveur de production
# Remplissez TOUTES les valeurs obligatoires avant de démarrer Gunicorn/Docker
# =====================================================================

# ---------------------------------------------------------------------
# 1. ENVIRONNEMENT & DÉBOGAGE (DURCI)
# ---------------------------------------------------------------------
DJANGO_ENV=production
DJANGO_DEBUG=False

# ---------------------------------------------------------------------
# 2. SECRETS CRYPTOGRAPHIQUES (STRICTS - LONGUEUR >= 32 CHARS)
# Générez chaque secret avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------
SECRET_KEY=PROD_REPLACE_WITH_UNIQUE_RANDOM_SECRET_KEY_MIN_50_CHARS_HEX_OR_URLSAFE
API_KEY=PROD_REPLACE_WITH_STRONG_RANDOM_API_KEY_TOKEN_MIN_32_CHARS
HASH_SALT=PROD_REPLACE_WITH_CRYPTO_SALT_TOKEN_MATCHING_MOBILE_APP_MIN_32_CHARS

# ---------------------------------------------------------------------
# 3. CONTRÔLE D'ACCÈS HTTP & DOMAINES (SANS JOKER '*')
# ---------------------------------------------------------------------
# Domaines complets autorisés séparés par une virgule
ALLOWED_HOSTS=api.shieldnet.app,admin.shieldnet.app

# Origines autorisées pour les requêtes CORS (Console admin, site vitrine)
CORS_ALLOWED_ORIGINS=https://admin.shieldnet.app,https://shieldnet.app

# Origines de confiance pour l'authentification et les formulaires CSRF
CSRF_TRUSTED_ORIGINS=https://admin.shieldnet.app,https://api.shieldnet.app

# ---------------------------------------------------------------------
# 4. SÉCURITÉ TLS / SSL & EN-TÊTES HTTP DE PRODUCTION
# ---------------------------------------------------------------------
# Forcer la redirection vers HTTPS (Reverse-proxy Nginx / Traefik / ALB)
SECURE_SSL_REDIRECT=True

# Durée de validité HSTS en secondes (31536000 = 1 an)
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------
# 5. BASE DE DONNÉES POSTGRESQL (PRODUCTION)
# ---------------------------------------------------------------------
POSTGRES_DB=shieldnet_production
POSTGRES_USER=shieldnet_pg_user
POSTGRES_PASSWORD=STRONG_COMPLEX_POSTGRES_PASSWORD_TO_SET
POSTGRES_HOST=postgres-cluster.internal
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# 6. CACHE DISTRIBUÉ REDIS (HAUTE PERFORMANCE)
# ---------------------------------------------------------------------
REDIS_URL=redis://:REDIS_AUTH_PASSWORD@redis-cluster.internal:6379/0

# ---------------------------------------------------------------------
# 7. COMPTE ADMINISTRATEUR SOC INITIAL
# ---------------------------------------------------------------------
ADMIN_EMAIL=soc-admin@shieldnet.app
ADMIN_PASSWORD=REPLACE_WITH_VERY_STRONG_SOC_ADMIN_PASSPHRASE

# ---------------------------------------------------------------------
# 8. EXPÉDITION DES COURRIELS DE PRODUCTION (SMTP)
# ---------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.YOUR_SENDGRID_OR_SES_PRODUCTION_KEY
DEFAULT_FROM_EMAIL=ShieldNet Security <security@shieldnet.app>

# ---------------------------------------------------------------------
# 9. MONITORING & OBSERVABILITÉ (SENTRY OPTIONNEL)
# ---------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@o123.ingest.sentry.io/456
