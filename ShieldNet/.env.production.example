# =====================================================================
# ShieldNet Mobile — Modèle d'Environnement de PRODUCTION (.env.production.example)
# Copiez ce fichier sous le nom .env sur votre machine de build ou intégrez via --dart-define
# =====================================================================

# URL de l'API de Production sous HTTPS strict (TLS 1.2+ obligatoire)
API_BASE_URL=https://api.shieldnet.app/api/v1

# Clé API de production partagée avec le backend (Doit correspondre exactement à API_KEY du backend)
API_KEY=PROD_REPLACE_WITH_STRONG_RANDOM_API_KEY_TOKEN_MIN_32_CHARS

# Sel cryptographique pour le hachage HMAC-SHA256 (Doit correspondre exactement à HASH_SALT du backend)
HASH_SALT=PROD_REPLACE_WITH_CRYPTO_SALT_TOKEN_MATCHING_BACKEND_MIN_32_CHARS

# Empreinte SHA-256 du certificat SSL du serveur pour le Certificate Pinning (sans les deux-points)
# Exemple : a1b2c3d4e5f6...
SSL_PINNED_SHA256=

# Durée de rétention du cache local SQLite (heures)
OFFLINE_CACHE_TTL_HOURS=72

# Filtrage automatique activé par défaut
ENABLE_AUTO_BLOCKING=true

# Clé DSN Sentry pour le suivi des crashes en production
# SENTRY_DSN=https://your-mobile-sentry-dsn@o123.ingest.sentry.io/789
