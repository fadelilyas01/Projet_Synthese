# =====================================================================
# ShieldNet Mobile — Modèle de configuration d'environnement (.env.example)
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement
# IMPORTANT : Ne jamais commiter de fichier .env contenant de vraies clés.
# =====================================================================

# URL de base de l'API Django REST
# - Appareil physique USB (avec adb reverse) ou Desktop/Web : http://127.0.0.1:8000/api/v1
# - Réseau Wi-Fi local : http://192.168.x.x:8000/api/v1
# - Émulateur Android Studio : http://10.0.2.2:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Jeton d'authentification API client (doit correspondre à API_KEY du backend)
API_KEY=change-me-to-a-secure-random-api-key-token

# Sel cryptographique unique pour le hachage HMAC-SHA256 (doit correspondre exactement à HASH_SALT du backend)
HASH_SALT=change-me-to-a-secure-random-crypto-salt-token

# Durée de rétention du cache local SQLite (heures)
OFFLINE_CACHE_TTL_HOURS=24

# Activation du filtrage automatique des appels indésirables
ENABLE_AUTO_BLOCKING=true

# Clé DSN Sentry (monitoring d'erreurs et crash reporting - optionnel)
SENTRY_DSN=
